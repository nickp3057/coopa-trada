# Copy to .env (git-ignored). Loaded by python-dotenv in development.
# Leave everything blank for DRY-RUN work.

# --- Schwab Trader API credentials (from the Schwab developer portal) ---
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Path to the OAuth token file minted by the one-time interactive login.
# See README "One-time token login".
SCHWAB_TOKEN_PATH=./schwab_token.json

# Optional: pin a specific account. If unset, the first account is used.
SCHWAB_ACCOUNT_ID=

# --- Live-trading opt-in #2 (opt-in #1 is the --live CLI flag) ---
# Must be exactly 1 (or true/yes/on) for real orders. Anything else => DRY-RUN.
LIVE_TRADING=0

# --- Alerts (optional phone push via the ntfy app; Mac notifications are always on) ---
# A long random channel name (24-64 letters, digits, - or _). Anyone who knows it
# can read the alerts, so generate it; never make one up:
#   python3 -c "import secrets; print('coopa-' + secrets.token_urlsafe(24))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
