# Copy to .env (git-ignored). Loaded by python-dotenv in development.
# Leave everything blank for DRY-RUN work.

# --- Schwab Trader API credentials (from the Schwab developer portal) ---
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Path to the OAuth token file minted by the one-time interactive login.
# See README "One-time token login".
SCHWAB_TOKEN_PATH=./schwab_token.json

# Optional: pin a specific account. If unset, the first account is used.
SCHWAB_ACCOUNT_ID=

# --- May this bot ever trade real money? ---
# 1 (or true/yes/on) allows it; anything else => practice only, whatever the website says.
# With 1, the everyday on/off is the Dashboard's "Real money" switch (starts off;
# turning it on takes the typed phrase). The website never changes this line.
LIVE_TRADING=0

# --- Alerts (optional phone push via the ntfy app; Mac notifications are always on) ---
# A long random channel name (24-64 letters, digits, - or _). Anyone who knows it
# can read the alerts, so generate it; never make one up:
#   python3 -c "import secrets; print('coopa-' + secrets.token_urlsafe(24))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Picture reader for pick screenshots (dashboard upload and Telegram) ---
# auto (default): Apple's built-in reader on a Mac, otherwise the Claude reader.
# claude: always use Claude. apple: always use Apple (Mac only).
COOPA_IMAGE_READER=auto
# Claude API key (console.anthropic.com). Needed for the Claude reader. The
# picture is sent to Anthropic to be read; nothing trades until a person
# confirms the preview.
ANTHROPIC_API_KEY=

# --- Telegram intake (optional; see docs/TELEGRAM_SETUP.md) ---
# The bot token from @BotFather. Anyone with it can control the bot: keep it secret.
TELEGRAM_BOT_TOKEN=
# Chat IDs allowed to send picks, comma-separated (Cooper's, Nick's). Every
# other chat is ignored.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Server use (docs/SERVER_SETUP.md) ---
# Password for the dashboard (HTTP login, any user name). Required to listen on
# anything but 127.0.0.1. Leave blank behind the login website (coopa_trada.gateway,
# docs/SERVER_SETUP.md), which handles logins with a password and 2FA. 12+ characters.
DASHBOARD_PASSWORD=
